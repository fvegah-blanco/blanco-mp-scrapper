# Base de datos (docker compose up -d db)
DATABASE_URL=postgresql://mp:mp@localhost:5440/mp

PORT=4500

# Protege /api con el header x-admin-key. Vacío = abierto (solo desarrollo).
ADMIN_API_KEY=

# true/false fuerza todos los crons de este proceso; vacío = decide la tabla cron_job_configs.
CRONS_ENABLED=

# Dónde quedan los adjuntos descargados. Con S3_BUCKET se suben a S3 en vez de disco.
STORAGE_DIR=./storage
S3_BUCKET=
S3_PREFIX=mp-scrapper
AWS_REGION=us-east-1

# Directorio temporal para los .zip de datos abiertos (230 MB descomprimido por mes de OC).
TMP_DIR=./tmp

# Claves públicas que el propio buscador de Mercado Público incrusta en su bundle JS.
# No son secretas; se dejan configurables por si ChileCompra las rota.
MP_BUSCADOR_API_KEY=e93089e4-437c-4723-b343-4fa20045e3bc
MP_ADJUNTOS_USER_KEY=41186b85826e80d1a0d445a6ce67d1a3

# Idiomas de Tesseract para el OCR (se descargan la primera vez).
OCR_LANGS=spa+eng
